APP_NAME="GIMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gims-barmm.southeastasia.cloudapp.azure.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# ── Branding (same as local) ──
APP_BRAND_NAME="GIP Information Management System (GIMS)"
APP_BRAND_SHORT="GIMS"
APP_FOLDER_PREFIX="CSC"
APP_BARCODE_PREFIX="CSC"
APP_PASSWORD_SUFFIX="gip"
APP_BRAND_LOGO="image/dole-emblem.png"
APP_BRAND_LOGO_FULL="image/dole-logo.png"
APP_BRAND_COLOR="#1E429B"

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ── Azure Database for MySQL (TLS required) ──
DB_CONNECTION=mysql
DB_HOST=CHANGE-ME.mysql.database.azure.com
DB_PORT=3306
DB_DATABASE=gips_db
DB_USERNAME=gimsapp
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/DigiCertGlobalRootG2.crt.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Meilisearch is not deployed; use the built-in collection driver
SCOUT_DRIVER=collection
SCOUT_QUEUE=false
