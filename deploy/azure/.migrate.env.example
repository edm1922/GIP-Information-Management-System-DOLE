# GIMS — local (XAMPP/MariaDB) -> Azure Database for MySQL data migration
# Run from the LOCAL machine:  php deploy/azure/05-migrate-data.php [--dry-run]
#
# Prerequisite: the target schema must already exist (run on the VM):
#   sudo -u www-data php artisan migrate --force
#
# Copy this file to .migrate.env and fill in the values. NEVER commit .migrate.env.
SOURCE_HOST=127.0.0.1
SOURCE_PORT=3306
SOURCE_DB=gips_db
SOURCE_USER=root
SOURCE_PASS=

TARGET_HOST=CHANGE-ME.mysql.database.azure.com
TARGET_PORT=3306
TARGET_DB=gips_db
TARGET_USER=gimsapp
TARGET_PASS=

# DigiCert Global Root G2 (Azure MySQL CA). Download it first:
#   https://cacerts.digicert.com/DigiCertGlobalRootG2.crt.pem
TARGET_SSL_CA=deploy/azure/ca/DigiCertGlobalRootG2.crt.pem
