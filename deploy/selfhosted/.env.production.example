# GIMS self-hosted production environment.
#
# Copy to `.env` (same directory as docker-compose.yml) and fill in every
# CHANGE-ME value:
#   cp .env.production.example .env && chmod 600 .env
#
# Two audiences read this file:
#   1. docker compose — interpolates DB_DATABASE, DB_USERNAME, DB_PASSWORD,
#      MEILISEARCH_KEY, NGINX_HOST_PORT and CLOUDFLARE_TUNNEL_TOKEN.
#      Because of that, do NOT use a literal `$` in those values; write `$$`.
#   2. Laravel — receives the rest via `env_file`, and real environment
#      variables win over any other .env inside the container.
#
# Never commit the real .env.

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="GIMS"
APP_ENV=production
# Generate with: openssl rand -base64 32  → prefix the result with "base64:"
APP_KEY=
APP_DEBUG=false
# Public URL of the Laravel API (the Cloudflare Tunnel hostname).
APP_URL=https://api.example.com
# Public URL of the Next.js frontend (Vercel).
FRONTEND_URL=https://app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

APP_BRAND_NAME="GIP Information Management System (GIMS)"
APP_BRAND_SHORT="GIMS"
APP_FOLDER_PREFIX="CSC"
APP_BARCODE_PREFIX="CSC"
APP_PASSWORD_SUFFIX="gip"
APP_BRAND_LOGO="image/dole-emblem.png"
APP_BRAND_LOGO_FULL="image/dole-logo.png"
APP_BRAND_COLOR="#1E429B"

BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────────────────────
# Logging (stderr → Docker json-file logs, rotated by docker-compose)
# ─────────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL service inside Compose — never published to the host)
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gims
DB_USERNAME=gims
# CHANGE-ME: long random value. No literal `$` (use `$$` if you need one).
DB_PASSWORD=
DB_CHARSET=utf8
# TLS is terminated by the tunnel, not between containers. `require` would fail
# here because the Compose network connection is plaintext.
DB_SSLMODE=prefer

# ─────────────────────────────────────────────────────────────────────────────
# Session / Sanctum / CORS
# ─────────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=gims_session
SESSION_PATH=/
# Must be the shared parent domain so the API host can read the cookie set by
# the frontend host (e.g. app.example.com + api.example.com → .example.com).
# Use `null` only if there is a single host serving both the SPA and the API.
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sanctum only starts the session/cookie middleware when the request's
# Origin/Referer matches this list. List the frontend host (and the API host if
# you ever call it from a browser tab). Never `*` in production.
SANCTUM_STATEFUL_DOMAINS=app.example.com,api.example.com

CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_SUPPORTS_CREDENTIALS=true

# Cloudflare Tunnel/reverse proxy headers are trusted. Only nginx is reachable
# (loopback + the private Compose network), so `*` is acceptable and required
# for correct HTTPS detection behind the tunnel.
TRUSTED_PROXIES=*

# ─────────────────────────────────────────────────────────────────────────────
# Queue / cache / filesystem
# ─────────────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─────────────────────────────────────────────────────────────────────────────
# Search (Meilisearch service inside Compose)
# ─────────────────────────────────────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
# CHANGE-ME: at least 16 characters. Meilisearch refuses to start in production
# mode with a shorter key. No literal `$` (use `$$`).
MEILISEARCH_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Mail (default: written to the log; switch to smtp for real delivery)
# ─────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
# Literal value: env_file entries are not shell-expanded by Compose.
MAIL_FROM_NAME="GIMS"

# ─────────────────────────────────────────────────────────────────────────────
# Deploy/backup script safety switches (read by scripts, ignored by Laravel)
# ─────────────────────────────────────────────────────────────────────────────
# deploy.sh --migrate / --initialize refuse to run unless this is exactly "yes".
# Set it to yes for the duration of the command, then back to no.
ALLOW_MIGRATIONS=no
# Backup retention (defaults: keep the newest 7, delete sets older than 14 days).
# BACKUP_RETENTION_DAYS=14
# BACKUP_KEEP_MIN=7

# ─────────────────────────────────────────────────────────────────────────────
# Compose-only settings
# ─────────────────────────────────────────────────────────────────────────────
# Loopback port used by ./scripts/verify.sh. Keep 8080 unless it is taken.
NGINX_HOST_PORT=8080
# Remotely-managed Cloudflare Tunnel token (Cloudflare dashboard → Networks →
# Tunnels → your tunnel → Install connector). Leave empty only when using the
# locally-managed config file instead (see cloudflared/config.yml.example).
CLOUDFLARE_TUNNEL_TOKEN=

# Future S3-compatible off-host storage (optional; leave blank for local disk).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false
