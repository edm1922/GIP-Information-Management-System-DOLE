APP_NAME=CSC-Document-Management-System
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=${APP_URL:-http://localhost}

# Frontend/API split (Sanctum SPA) — configure per environment
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Production example:
# APP_URL=https://api.example.com
# FRONTEND_URL=https://gims.example.com
# CORS_ALLOWED_ORIGINS=https://gims.example.com
# SANCTUM_STATEFUL_DOMAINS=gims.example.com
# SESSION_DOMAIN=.example.com
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ── Branding ──
APP_BRAND_NAME="GIP Information Management System (GIMS)"
APP_BRAND_SHORT="GIMS"
APP_FOLDER_PREFIX="CSC"
APP_BARCODE_PREFIX="CSC"
APP_PASSWORD_SUFFIX="gip"
APP_BRAND_LOGO="image/dole-emblem.png"
APP_BRAND_LOGO_FULL="image/dole-logo.png"
APP_BRAND_COLOR="#1E429B"

# Local `php artisan serve` only; ignored by PHP-FPM in production.
# Windows PHP has no fork() support, so `serve` falls back to a single worker.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=${DB_HOST:-127.0.0.1}
DB_PORT=${DB_PORT:-5432}
DB_DATABASE=${DB_DATABASE:-postgres}
DB_USERNAME=${DB_USERNAME:-postgres}
DB_PASSWORD=${DB_PASSWORD:-}
DB_CHARSET=utf8
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP example (credentials are Google App Passwords, never commit them):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=your.address@gmail.com
# MAIL_PASSWORD=xxxxxxxxxxxxxxxx
# MAIL_FROM_ADDRESS=your.address@gmail.com

# Public intern self-registration (FRONTEND_URL above builds the shareable link)
# Hours per working day used for the remaining-days estimate (per-intern override available)
# INTERNSHIP_HOURS_PER_WORKDAY=8

# INTERNSHIP_REGISTRATION_LINK_TTL_DAYS=30
# INTERNSHIP_REGISTRATION_MAX_SUBMISSIONS=5
# INTERNSHIP_REGISTRATION_WINDOW_MINUTES=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=false
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
