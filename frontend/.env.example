# Local development against `php artisan serve --host=localhost --port=8000`:
# use `localhost` for both apps so the Sanctum session cookie is same-site.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production, option 1 — API on a sibling domain (cookie sharing relies on a
# shared registrable domain):
# NEXT_PUBLIC_API_URL=https://api.example.com

# Production, option 2 — API on another domain (e.g. a Cloudflare quick tunnel).
# Leave NEXT_PUBLIC_API_URL unset so requests go to the app's own origin, and
# point this at the API; next.config.ts proxies /api/v1/* and
# /sanctum/csrf-cookie to it. Build-time value: changing it needs a redeploy.
# API_PROXY_TARGET=https://random-words.trycloudflare.com

# Brand values mirrored from config/brand.php. Public (non-secret) only.
NEXT_PUBLIC_BRAND_NAME=GIP Information Management System (GIMS)
NEXT_PUBLIC_BRAND_SHORT=GIMS
NEXT_PUBLIC_BRAND_PRIMARY=#1E429B
NEXT_PUBLIC_FOLDER_PREFIX=CSC
# Must mirror APP_PASSWORD_SUFFIX (config/brand.php) for the "default password" hint.
NEXT_PUBLIC_DEFAULT_PASSWORD_SUFFIX=gip
