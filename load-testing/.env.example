# ---------------------------------------------------------------------------
# GIMS load-testing configuration (copy to load-testing/.env and adjust).
#
# Do NOT put real user credentials here. Test-account credentials live in
# accounts.json, which is generated by provision/provision-test-accounts.php
# and is gitignored.
# ---------------------------------------------------------------------------

# Laravel backend under test.
#   Local dev server (default):      http://127.0.0.1:8000
#   XAMPP/Apache virtual host:       http://gims.test
# Keep this on the local machine: routing load through Cloudflare/Vercel would
# load-test third-party services, which the safety rules exclude.
API_BASE_URL=http://127.0.0.1:8000

# Deployed Next.js frontend (only used by scripts/frontend-smoke.js, or when
# ENABLE_FRONTEND_CHECKS=1 in the read workflow). Leave disabled for backend
# load tests so Vercel/Cloudflare are not part of the measured system.
FRONTEND_URL=https://gims-dole12.vercel.app
ENABLE_FRONTEND_CHECKS=0

# Smoke | small | medium | target
PROFILE=smoke

# Think time between user actions, in seconds. The API group is throttled at
# 120 requests/minute per authenticated user; 6-8 requests per iteration with a
# 3-5 s think time stays well below that (see README "Rate limits").
THINK_TIME_MIN=3
THINK_TIME_MAX=5

# Request that the search step sends. Use a value that exists in your data.
SEARCH_TERM=a

# Thresholds (milliseconds). Relax these deliberately, not accidentally.
THRESHOLD_P95_MS=1500
THRESHOLD_P99_MS=3000
